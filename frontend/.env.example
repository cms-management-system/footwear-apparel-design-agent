# Browser links contain public URLs only; adjust for your installation.
NEXT_PUBLIC_LINK_OUTFIT=http://localhost:3090
NEXT_PUBLIC_LINK_PRODUCT=http://localhost:3091
NEXT_PUBLIC_LINK_DESIGN=http://localhost:3092

# Same-origin API proxy. No model keys or server credentials belong in frontend env.
BACKEND_BASE_URL=http://127.0.0.1:8092
# Optional subpath and independent build output.
NEXT_PUBLIC_BASE_PATH=
NEXT_DIST_DIR=.next
# DESIGN_DEMO_ACCESS_ENABLED is a backend-only, default-off setting.
