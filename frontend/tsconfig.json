{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-direct-20261010/types/**/*.ts",
    ".next-direct-status-20261010/types/**/*.ts",
    ".next-fullchain-20261010/types/**/*.ts",
    ".next-partner-20261010/types/**/*.ts",
    ".next-unified/types/**/*.ts",
    ".next-workspace-20261010/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-demo-access-20261010/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
