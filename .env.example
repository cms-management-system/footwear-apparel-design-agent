# 鞋服智能设计 Agent · 配置模板（复制为 .env 使用；不要提交 .env）
# 当前独立本机演示：服务端默认关闭；本模板明确启用。只监听 127.0.0.1。
DESIGN_INTEGRATION_MODE=managed
DESIGN_INSTANCE_ID=design-local-demo
DESIGN_SCOPE_ID=local-demo-scope
DESIGN_ALLOWED_ORIGINS=http://localhost:3092,http://127.0.0.1:3092
DESIGN_DEMO_ACCESS_ENABLED=true
DESIGN_DEMO_DESIGNER_USERNAME=design-employee-a
DESIGN_MANAGER_USERNAME=design-manager
DESIGN_MANAGER_PASSWORD_HASH=
DESIGN_PAID_PROVIDERS_ENABLED=false
DESIGN_SESSION_COOKIE_SECURE=false
# 运营模型策略须另外明确配置；模板不授收费额度。无需账号步骤即可查看/创建空白。
DESIGN_INTERACTIVE_POLICY_FILE=
DESIGN_CREATION_AUTHORIZATION_FILE=
# 用火山方舟出图时填下面几行（Key 不要提交、不要发在对话里）
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 控制台「模型广场」里开通的图像模型 ID（以控制台显示为准）
IMAGE_MODEL=
# 方舟 seedream 5.0 要求 ≥3,686,400 像素；1024x1024 会被拒（实测 400）
IMAGE_SIZE=2K
# 参考图传参：list（默认，JSON 数组，火山方舟）或 single（只传最相关的一张字符串）
# single 用于拒绝数组的 OpenAI 兼容中转，例如 https://api.ai-tudou.net/v1 的 gpt-image-2-all
IMAGE_REFERENCE_FORMAT=list

DATABASE_URL=sqlite:///data/app.sqlite3
ASSETS_DIR=data/assets

# CMS 协作中枢。密钥只放在后端，不要写进前端环境变量，也不要提交真实密钥。
CMS_BASE_URL=http://127.0.0.1:8001
CMS_API_KEY=
CMS_TIMEOUT=10
# 回传 design_image 时拼绝对地址，需能被 CMS 或审阅人打开
PUBLIC_BASE_URL=http://127.0.0.1:8020
# 从知需产品工作台直接读取已批准需求，并回传设计反馈；密钥仅在服务端。
PRODUCT_HANDOFF_URL=http://127.0.0.1:3112
PRODUCT_HANDOFF_KEY=
DESIGN_AUTH_REQUIRED=true
# 空人员库首次启动自动初始化合成员工/经理；现有库只核映射，不改密码/角色。

# 多模态共创 Agent（未配置时仅保存素材/要求，不退化为 mock）
AGENT_ENABLED=false
AGENT_WORKER_ENABLED=true
AGENT_VISION_BASE_URL=
AGENT_VISION_THINKING=disabled
AGENT_VISION_MODEL=
AGENT_VISION_API_KEY=
# 确认现有 IMAGE_MODEL 支持 b64_json，以及 IMAGE_REFERENCE_FORMAT 对应的参考图写法后启用
AGENT_REFERENCE_IMAGES_ENABLED=false
# 按输入上限、4096 输出 token、单张 2K 核实每次调用费用上界（分）；0 禁止调用
AGENT_REASONING_CALL_MAX_FEN=0
AGENT_IMAGE_CALL_MAX_FEN=0
# 从原有全产品每月 200 元预算中划拨的额度，须扣除旧流程预计使用额
AGENT_MONTHLY_ALLOCATION_FEN=0

# 按单款效果图生成真实 GLB 3D 预览（火山方舟影眸 Hyper3D Gen2）。默认关闭，不触发计费。
# 须先在控制台开通 3D 模型，并从全产品每月 ¥200 上限中单独划拨费用；当前公开价约 ¥1.80/款。
AGENT_3D_ENABLED=false
# 可留空复用 IMAGE_API_KEY；密钥仅后端使用
AGENT_3D_API_KEY=
AGENT_3D_MONTHLY_ALLOCATION_FEN=0

# Optional exact HTTPS host allowlist for providers returning image URLs; empty disables downloads.
AGENT_IMAGE_DOWNLOAD_HOSTS=
