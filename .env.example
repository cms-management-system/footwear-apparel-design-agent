# 鞋服智能设计 Agent · 配置模板（复制为 .env 使用；不要提交 .env）
# 用火山方舟出图时填下面三行（Key 不要提交、不要发在对话里）
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL=                   # 控制台「模型广场」里开通的图像模型 ID（以控制台显示为准）
IMAGE_SIZE=2K                  # 方舟 seedream 5.0 要求 ≥3,686,400 像素；1024x1024 会被拒（实测 400）

DATABASE_URL=sqlite:///data/app.sqlite3
ASSETS_DIR=data/assets

# CMS 协作中枢。密钥只放在后端，不要写进前端环境变量，也不要提交真实密钥。
CMS_BASE_URL=http://127.0.0.1:8001
CMS_API_KEY=
CMS_TIMEOUT=10
# 回传 design_image 时拼绝对地址，需能被 CMS 或审阅人打开
PUBLIC_BASE_URL=http://127.0.0.1:8020

# 多模态共创 Agent（未配置时仅保存素材/要求，不退化为 mock）
AGENT_ENABLED=false
AGENT_WORKER_ENABLED=true
AGENT_VISION_BASE_URL=
AGENT_VISION_THINKING=disabled
AGENT_VISION_MODEL=
AGENT_VISION_API_KEY=
# 确认现有 IMAGE_MODEL 支持 image 数组与 b64_json 后启用
AGENT_REFERENCE_IMAGES_ENABLED=false
# 按输入上限、4096 输出 token、单张 2K 核实每次调用费用上界（分）；0 禁止调用
AGENT_REASONING_CALL_MAX_FEN=0
AGENT_IMAGE_CALL_MAX_FEN=0
# 从原有全产品每月 200 元预算中划拨的额度，须扣除旧流程预计使用额
AGENT_MONTHLY_ALLOCATION_FEN=0

# 按单款效果图生成真实 GLB 3D 预览（火山方舟影眸 Hyper3D Gen2）。默认关闭，不触发计费。
# 须先在控制台开通 3D 模型，并从全产品每月 ¥200 上限中单独划拨费用；当前公开价约 ¥1.80/款。
AGENT_3D_ENABLED=false
# 可留空复用 IMAGE_API_KEY；密钥仅后端使用
AGENT_3D_API_KEY=
AGENT_3D_MONTHLY_ALLOCATION_FEN=0
